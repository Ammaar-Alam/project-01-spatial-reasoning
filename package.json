{
  "name": "spatial-reasoning-benchmark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm tasks:check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "tasks:check": "node src/check-tasks.ts"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
