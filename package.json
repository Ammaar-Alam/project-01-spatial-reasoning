{
  "name": "spatial-reasoning-benchmark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm tasks:check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc && tsc -p web",
    "test": "node --test \"{src,web}/**/*.test.ts\"",
    "tasks:check": "node src/check-tasks.ts",
    "bench": "node src/run.ts",
    "editor": "node src/editor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "openai": "7.32.0",
    "three": "0.186.1",
    "undici": "7.30.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "7.0.2"
  }
}
